# =============================================================================
# LPG Stock Recon App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values from your NEW dedicated
# Supabase project (NOT the shared delivery app project).
#
# 1. Create a new Supabase project at https://app.supabase.com
# 2. Go to Project Settings → Database → Connection String
# 3. Copy "URI" (with password) into DATABASE_URL (use ?pgbouncer=true for pooler)
# 4. Copy "Direct connection" URI into DIRECT_URL (Prisma migrations need this)
# 5. Go to Project Settings → API
# 6. Copy "Project URL" into VITE_SUPABASE_URL
# 7. Copy "anon / public" key into VITE_SUPABASE_ANON_KEY
# =============================================================================

# --- Prisma (server-side) ---
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# --- Supabase JS Client (frontend / Edge Functions) ---
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."
