generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  role           UserRole          @default(USER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  allocations    AllocationEvent[] @relation("user_allocations")
  matchDecisions MatchDecision[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  accountNo         String   @unique @map("accno")
  currentName       String
  accountType       String?  @map("account_type")
  typicalReturnDays Int?     @map("typical_return_days")
  partialReturnProb Float?   @map("partial_return_prob")
  commonPatterns    String[] @map("common_patterns")
  specialRules      String?  @map("special_rules")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("accounts")
}

model Product {
  id          String                @id @default(cuid())
  stockNo     String                @unique @map("stockno")
  description String
  category    String?
  group       String?
  brand       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lineItems   TransactionLineItem[]

  @@map("products")
}

model SalesRep {
  id        String                @id @default(cuid())
  repCode   String                @unique @map("rep")
  name      String?
  lineItems TransactionLineItem[]

  @@map("sales_reps")
}

model TransactionHeader {
  id           BigInt    @id @default(autoincrement())
  entry_type   String?
  period       Int?
  account_no   String?
  account_name String?
  doc_no       String?
  ref_no       String?
  description  String?
  order_no     String?
  batch_ref    String?
  tx_date      DateTime? @db.Date
  amount_excl  Decimal?  @db.Decimal
  tax_amount   Decimal?  @db.Decimal
  tax_code     String?
  discount     Decimal?  @db.Decimal
  flag         String?
  source_file  String?
  fingerprint  String?   @unique
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([account_no], map: "idx_headers_account_no")
  @@index([doc_no], map: "idx_headers_doc_no")
  @@map("transaction_headers")
}

model TransactionLineItem {
  id            String    @id @default(cuid())
  transactionId String    @map("transaction_id")
  docNo         String    @map("docno")
  accountNo     String    @map("accno")
  entryType     EntryType @map("entry")
  period        Int
  date          DateTime
  productId     String?   @map("product_id")
  stockNo       String?   @map("stockno")
  description   String?
  category      String?
  group         String?
  brand         String?
  quantity      Decimal   @db.Decimal(18, 3)
  retailPrice   Decimal   @map("retail") @db.Decimal(18, 4)
  costPrice     Decimal   @map("cost") @db.Decimal(18, 4)
  orderNo       String?   @map("orderno")
  repId         String?   @map("rep_id")
  repCode       String?   @map("rep")
  ref           String?
  user          String?
  location      String?
  contract      String?
  comms         Decimal   @db.Decimal(18, 4)
  lineComms     Decimal   @map("linecomms") @db.Decimal(18, 4)
  taxCode       Int       @map("taxcode")
  lineTax       Decimal   @map("linetax") @db.Decimal(18, 2)
  projNo        String?   @map("projno")
  department    String?
  retail1       Decimal?  @map("sretail1") @db.Decimal(18, 4)
  retail2       Decimal?  @map("sretail2") @db.Decimal(18, 4)
  retail3       Decimal?  @map("sretail3") @db.Decimal(18, 4)
  retail4       Decimal?  @map("sretail4") @db.Decimal(18, 4)
  retail5       Decimal?  @map("sretail5") @db.Decimal(18, 4)
  retail6       Decimal?  @map("sretail6") @db.Decimal(18, 4)
  product       Product?  @relation(fields: [productId], references: [id])
  salesRep      SalesRep? @relation(fields: [repId], references: [id])

  @@index([transactionId])
  @@index([docNo])
  @@index([stockNo])
  @@map("transaction_line_items")
}

model AllocationEvent {
  id             String              @id @default(cuid())
  sourceId       String              @map("source_id")
  targetId       String              @map("target_id")
  amount         Decimal             @db.Decimal(18, 2)
  eventType      AllocationEventType @map("event_type")
  allocationType AllocationType      @map("allocation_type")
  matchMethod    MatchMethod         @map("match_method")
  reason         String?
  notes          String?
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now())
  createdBy      User?               @relation("user_allocations", fields: [createdById], references: [id])

  @@index([sourceId])
  @@index([targetId])
  @@index([createdAt])
  @@map("allocation_events")
}

model MatchDecision {
  id               String       @id @default(cuid())
  sourceId         String       @map("source_id")
  targetId         String       @map("target_id")
  decision         DecisionType
  systemConfidence Int          @map("system_confidence")
  humanConfidence  Int?         @map("human_confidence")
  reasonCodes      String[]     @map("reason_codes")
  notes            String?
  createdById      String?      @map("created_by_id")
  createdAt        DateTime     @default(now())
  createdBy        User?        @relation(fields: [createdById], references: [id])

  @@map("match_decisions")
}

model PatternLibrary {
  id          String   @id @default(cuid())
  patternKey  String   @unique @map("pattern_key")
  patternType String
  confidence  Int
  matchCount  Int      @default(0)
  acceptRate  Float    @default(0)
  lastSeen    DateTime @map("last_seen")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pattern_library")
}

model ReasonCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  category    String
  isActive    Boolean @default(true)

  @@map("reason_codes")
}

model ErpSnapshot {
  id           String   @id
  timestamp    DateTime
  exportTime   DateTime
  snapshotType String
  data         Json

  @@index([timestamp])
  @@map("erp_snapshots")
}

model PhysicalCountSession {
  id                    String                 @id
  timestamp             DateTime
  sessionType           String
  status                String
  zones                 Json
  counterName           String?
  notes                 String?
  syncedAt              DateTime?
  reconciliationReports ReconciliationReport[]

  @@index([timestamp])
  @@map("physical_count_sessions")
}

model MovementData {
  id        String    @id
  timestamp DateTime
  period    String
  movements Json
  syncedAt  DateTime?

  @@index([timestamp])
  @@map("movement_data")
}

model ReconciliationReport {
  id               String               @id
  timestamp        DateTime
  status           String
  pmPhysicalId     String
  amPhysicalId     String?
  pmErpId          String
  movementDataId   String?
  results          Json
  discrepancyNotes DiscrepancyNote[]
  pmPhysical       PhysicalCountSession @relation(fields: [pmPhysicalId], references: [id])

  @@index([timestamp])
  @@map("reconciliation_reports")
}

model DiscrepancyNote {
  id                     String               @id @default(cuid())
  reconciliationReportId String
  sku                    String
  note                   String
  resolutionStatus       String               @default("open")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  reconciliationReport   ReconciliationReport @relation(fields: [reconciliationReportId], references: [id])

  @@index([reconciliationReportId])
  @@index([sku])
  @@map("discrepancy_notes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String?  @db.Uuid
  action       String
  from_state   String?
  to_state     String?
  performed_by String?
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([session_id])
}

model counts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @db.Uuid
  data       Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  sessions   sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model idempotency_keys {
  key        String   @id
  response   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reconciliation_pipeline {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @unique @db.Uuid
  stage      String
  progress   Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime @db.Date
  current_state String   @default("OPEN")
  locked        Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  counts        counts[]
}

model sync_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename       String
  file_type      String
  records_synced Int
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model transaction_items {
  id            BigInt    @id @default(autoincrement())
  entry_type    String?
  period        Int?
  account_no    String?
  doc_no        String?
  stock_no      String?
  description   String?
  category      String?
  product_group String?
  brand         String?
  order_no      String?
  tx_date       DateTime? @db.Date
  qty           Decimal?  @db.Decimal
  retail_price  Decimal?  @db.Decimal
  cost_price    Decimal?  @db.Decimal
  reference     String?
  rep_code      String?
  user_code     String?
  location      String?
  tax_code      Int?
  line_tax      Decimal?  @db.Decimal
  rep_name      String?
  account_name  String?
  source_file   String?
  fingerprint   String?   @unique
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([doc_no], map: "idx_items_doc_no")
  @@index([stock_no], map: "idx_items_stock_no")
}

// =============================================================================
// Credit Card Purchase Intent, Capture & Statement Reconciliation
// Docs: docs/Card-Recon/Slice_Brief.md, UX_Blueprint.md, Dev_Plan.md
// Status fields are plain String (ALL CAPS, INV-006), not Prisma enums —
// matches the PhysicalCountSession/ReconciliationReport precedent above,
// not AllocationEvent's matchMethod enum, since these status vocabularies
// are specific to this epic and not shared with existing enums.
// =============================================================================

model LedgerAccount {
  id        String   @id @default(cuid())
  code      String   @unique // immutable after creation — no update path
  // exposes this field; enforced in the service layer, not the DB
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_accounts")
}

model PurchaseIntent {
  id                String   @id @default(cuid())
  description       String
  ledgerAccountCode String   @map("ledger_account_code") // FK -> LedgerAccount.code
  status            String   @default("OPEN") // OPEN | FULFILLED | ABANDONED
  requestedBy       String   @map("requested_by")
  requestedAt       DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)

  @@index([ledgerAccountCode])
  @@index([status])
  @@index([requestedBy])
  @@map("purchase_intents")
}

model CardCaptureRequest {
  id                String    @id @default(cuid())
  intentId          String?   @map("intent_id") // FK -> PurchaseIntent.id
  submittedBy       String    @map("submitted_by")
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  amount            Decimal   @db.Decimal(18, 2)
  purchaseDate      DateTime  @map("purchase_date") @db.Date
  description       String // required, max 200 chars in the UI — matches
  // PurchaseIntent.description's field spec (UX Blueprint, shared Field
  // spec across Quick Request and Capture Request)
  ledgerAccountCode String?   @map("ledger_account_code") // FK -> LedgerAccount.code,
  // nullable: pre-filled from a linked PurchaseIntent but always
  // editable (UX Blueprint), and the Capture Clerk can still pick/
  // override a different one at posting (Open Question 2, unresolved —
  // postCaptureRequest takes its own ledgerAccountCode parameter)
  receiptUrl        String    @map("receipt_url") // NOT NULL — mandatory (Slice Brief Section D).
  // Stores the private bucket's object PATH, not a public URL — the app
  // resolves a short-lived signed URL for display (FR-CCR-RECEIPT-001).
  receiptMimeType   String    @map("receipt_mime_type") // image/jpeg or application/pdf post-processing
  receiptSizeBytes  Int       @map("receipt_size_bytes") // processed size, not the original upload size
  status            String    @default("SUBMITTED") // SUBMITTED | BATCHED | POSTED | REJECTED
  rejectionReason   String?   @map("rejection_reason")
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)

  @@index([intentId])
  @@index([status])
  @@index([submittedBy])
  @@index([ledgerAccountCode])
  @@map("card_capture_requests")
}

model CardLedgerEntry {
  id                   String   @id @default(cuid())
  captureRequestId     String   @map("capture_request_id") // FK -> CardCaptureRequest.id
  capturedBy           String   @map("captured_by") // segregation-of-duties check field
  vendor               String // fixed card identifier — single-card MVP
  // assumption (Slice Brief Open Question 6)
  reference            String // receipt's own reference
  ledgerAccountCode    String   @map("ledger_account_code") // FK -> LedgerAccount.code
  date                 DateTime @db.Date
  amount               Decimal  @db.Decimal(18, 2)
  receiptUrl           String   @map("receipt_url") // private bucket object path — see CardCaptureRequest
  receiptMimeType      String   @map("receipt_mime_type")
  receiptSizeBytes     Int      @map("receipt_size_bytes")
  receiptUploadedAt    DateTime @map("receipt_uploaded_at") @db.Timestamptz(6) // when the file was
  // originally uploaded at capture time — NOT postedAt, which is the
  // Capture Clerk's later review action
  reconciliationStatus String   @default("UNRECONCILED") @map("reconciliation_status")
  // UNRECONCILED | RECONCILED | EXCEPTION_UNRESOLVED | EXCEPTION_CANCELLED
  postedBy             String   @map("posted_by") // the Capture Clerk
  postedAt             DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  @@index([captureRequestId])
  @@index([reconciliationStatus])
  @@index([capturedBy])
  @@index([ledgerAccountCode])
  @@map("card_ledger_entries")
}

model CardStatementLine {
  id           String    @id @default(cuid())
  sessionId    String    @map("session_id") // FK -> CardReconSession.id
  date         DateTime  @db.Date
  description  String // raw bank description text
  amount       Decimal   @db.Decimal(18, 2)
  status       String    @default("UNMATCHED")
  // UNMATCHED | MATCHED | EXCEPTION_UNRESOLVED | EXCEPTION_CANCELLED
  cancelReason String?   @map("cancel_reason")
  cancelledBy  String?   @map("cancelled_by")
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([status])
  @@map("card_statement_lines")
}

model CardReconMatch {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id") // FK -> CardReconSession.id
  statementLineId String   @map("statement_line_id") // FK -> CardStatementLine.id
  ledgerEntryId   String   @map("ledger_entry_id") // FK -> CardLedgerEntry.id
  matchMethod     String   @map("match_method") // AUTO_EXACT | AUTO_FUZZY | MANUAL
  matchedBy       String?  @map("matched_by") // null for AUTO_* — no human actor
  matchedAt       DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)

  @@index([sessionId])
  @@index([statementLineId])
  @@index([ledgerEntryId])
  @@map("card_recon_matches")
}

model CardReconSession {
  id                String    @id @default(cuid())
  status            String    @default("OPEN") // OPEN | DRAFT | FINALIZED
  statementFilename String    @map("statement_filename")
  importedBy        String    @map("imported_by")
  importedAt        DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  finalizedBy       String?   @map("finalized_by")
  finalizedAt       DateTime? @map("finalized_at") @db.Timestamptz(6)

  @@index([status])
  @@map("card_recon_sessions")
}

enum UserRole {
  USER
  REVIEWER
  SUPERVISOR
  ADMIN
}

enum EntryType {
  Invoice
  Payment
  Crd_Note @map("Crd Note")
  GRV
  STK_XFER
  Journal
  Deb_Note @map("Deb Note")
}

enum AllocationEventType {
  ALLOCATE
  DEALLOCATE
  ADJUST
}

enum AllocationType {
  FULL
  PARTIAL
  EXCESS
  ROUNDING
}

enum MatchMethod {
  AUTO_EXACT
  AUTO_PATTERN
  MANUAL
  ADJUSTED
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  DELETED
}

enum DecisionType {
  ACCEPT
  REJECT
  MODIFY
  ESCALATE
}
