generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  role           UserRole          @default(USER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  allocations    AllocationEvent[] @relation("user_allocations")
  matchDecisions MatchDecision[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  accountNo         String   @unique @map("accno")
  currentName       String
  accountType       String?  @map("account_type")
  typicalReturnDays Int?     @map("typical_return_days")
  partialReturnProb Float?   @map("partial_return_prob")
  commonPatterns    String[] @map("common_patterns")
  specialRules      String?  @map("special_rules")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("accounts")
}

model Product {
  id          String                @id @default(cuid())
  stockNo     String                @unique @map("stockno")
  description String
  category    String?
  group       String?
  brand       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lineItems   TransactionLineItem[]

  @@map("products")
}

model SalesRep {
  id        String                @id @default(cuid())
  repCode   String                @unique @map("rep")
  name      String?
  lineItems TransactionLineItem[]

  @@map("sales_reps")
}

model TransactionHeader {
  id           BigInt    @id @default(autoincrement())
  entry_type   String?
  period       Int?
  account_no   String?
  account_name String?
  doc_no       String?
  ref_no       String?
  description  String?
  order_no     String?
  batch_ref    String?
  tx_date      DateTime? @db.Date
  amount_excl  Decimal?  @db.Decimal
  tax_amount   Decimal?  @db.Decimal
  tax_code     String?
  discount     Decimal?  @db.Decimal
  flag         String?
  source_file  String?
  fingerprint  String?   @unique
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([account_no], map: "idx_headers_account_no")
  @@index([doc_no], map: "idx_headers_doc_no")
  @@map("transaction_headers")
}

model TransactionLineItem {
  id            String    @id @default(cuid())
  transactionId String    @map("transaction_id")
  docNo         String    @map("docno")
  accountNo     String    @map("accno")
  entryType     EntryType @map("entry")
  period        Int
  date          DateTime
  productId     String?   @map("product_id")
  stockNo       String?   @map("stockno")
  description   String?
  category      String?
  group         String?
  brand         String?
  quantity      Decimal   @db.Decimal(18, 3)
  retailPrice   Decimal   @map("retail") @db.Decimal(18, 4)
  costPrice     Decimal   @map("cost") @db.Decimal(18, 4)
  orderNo       String?   @map("orderno")
  repId         String?   @map("rep_id")
  repCode       String?   @map("rep")
  ref           String?
  user          String?
  location      String?
  contract      String?
  comms         Decimal   @db.Decimal(18, 4)
  lineComms     Decimal   @map("linecomms") @db.Decimal(18, 4)
  taxCode       Int       @map("taxcode")
  lineTax       Decimal   @map("linetax") @db.Decimal(18, 2)
  projNo        String?   @map("projno")
  department    String?
  retail1       Decimal?  @map("sretail1") @db.Decimal(18, 4)
  retail2       Decimal?  @map("sretail2") @db.Decimal(18, 4)
  retail3       Decimal?  @map("sretail3") @db.Decimal(18, 4)
  retail4       Decimal?  @map("sretail4") @db.Decimal(18, 4)
  retail5       Decimal?  @map("sretail5") @db.Decimal(18, 4)
  retail6       Decimal?  @map("sretail6") @db.Decimal(18, 4)
  product       Product?  @relation(fields: [productId], references: [id])
  salesRep      SalesRep? @relation(fields: [repId], references: [id])

  @@index([transactionId])
  @@index([docNo])
  @@index([stockNo])
  @@map("transaction_line_items")
}

model AllocationEvent {
  id             String              @id @default(cuid())
  sourceId       String              @map("source_id")
  targetId       String              @map("target_id")
  amount         Decimal             @db.Decimal(18, 2)
  eventType      AllocationEventType @map("event_type")
  allocationType AllocationType      @map("allocation_type")
  matchMethod    MatchMethod         @map("match_method")
  reason         String?
  notes          String?
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now())
  createdBy      User?               @relation("user_allocations", fields: [createdById], references: [id])

  @@index([sourceId])
  @@index([targetId])
  @@index([createdAt])
  @@map("allocation_events")
}

model MatchDecision {
  id               String       @id @default(cuid())
  sourceId         String       @map("source_id")
  targetId         String       @map("target_id")
  decision         DecisionType
  systemConfidence Int          @map("system_confidence")
  humanConfidence  Int?         @map("human_confidence")
  reasonCodes      String[]     @map("reason_codes")
  notes            String?
  createdById      String?      @map("created_by_id")
  createdAt        DateTime     @default(now())
  createdBy        User?        @relation(fields: [createdById], references: [id])

  @@map("match_decisions")
}

model PatternLibrary {
  id          String   @id @default(cuid())
  patternKey  String   @unique @map("pattern_key")
  patternType String
  confidence  Int
  matchCount  Int      @default(0)
  acceptRate  Float    @default(0)
  lastSeen    DateTime @map("last_seen")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pattern_library")
}

model ReasonCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  category    String
  isActive    Boolean @default(true)

  @@map("reason_codes")
}

model ErpSnapshot {
  id           String   @id
  timestamp    DateTime
  exportTime   DateTime
  snapshotType String
  data         Json

  @@index([timestamp])
  @@map("erp_snapshots")
}

model PhysicalCountSession {
  id                    String                 @id
  timestamp             DateTime
  sessionType           String
  status                String
  zones                 Json
  counterName           String?
  notes                 String?
  syncedAt              DateTime?
  reconciliationReports ReconciliationReport[]

  @@index([timestamp])
  @@map("physical_count_sessions")
}

model MovementData {
  id        String    @id
  timestamp DateTime
  period    String
  movements Json
  syncedAt  DateTime?

  @@index([timestamp])
  @@map("movement_data")
}

model ReconciliationReport {
  id               String               @id
  timestamp        DateTime
  status           String
  pmPhysicalId     String
  amPhysicalId     String?
  pmErpId          String
  movementDataId   String?
  results          Json
  discrepancyNotes DiscrepancyNote[]
  pmPhysical       PhysicalCountSession @relation(fields: [pmPhysicalId], references: [id])

  @@index([timestamp])
  @@map("reconciliation_reports")
}

model DiscrepancyNote {
  id                     String               @id @default(cuid())
  reconciliationReportId String
  sku                    String
  note                   String
  resolutionStatus       String               @default("open")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  reconciliationReport   ReconciliationReport @relation(fields: [reconciliationReportId], references: [id])

  @@index([reconciliationReportId])
  @@index([sku])
  @@map("discrepancy_notes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String?  @db.Uuid
  action       String
  from_state   String?
  to_state     String?
  performed_by String?
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([session_id])
}

model counts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @db.Uuid
  data       Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  sessions   sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model idempotency_keys {
  key        String   @id
  response   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reconciliation_pipeline {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @unique @db.Uuid
  stage      String
  progress   Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime @db.Date
  current_state String   @default("OPEN")
  locked        Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  counts        counts[]
}

model sync_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename       String
  file_type      String
  records_synced Int
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model transaction_items {
  id            BigInt    @id @default(autoincrement())
  entry_type    String?
  period        Int?
  account_no    String?
  doc_no        String?
  stock_no      String?
  description   String?
  category      String?
  product_group String?
  brand         String?
  order_no      String?
  tx_date       DateTime? @db.Date
  qty           Decimal?  @db.Decimal
  retail_price  Decimal?  @db.Decimal
  cost_price    Decimal?  @db.Decimal
  reference     String?
  rep_code      String?
  user_code     String?
  location      String?
  tax_code      Int?
  line_tax      Decimal?  @db.Decimal
  rep_name      String?
  account_name  String?
  source_file   String?
  fingerprint   String?   @unique
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([doc_no], map: "idx_items_doc_no")
  @@index([stock_no], map: "idx_items_stock_no")
}

enum UserRole {
  USER
  REVIEWER
  SUPERVISOR
  ADMIN
}

enum EntryType {
  Invoice
  Payment
  Crd_Note @map("Crd Note")
  GRV
  STK_XFER
  Journal
  Deb_Note @map("Deb Note")
}

enum AllocationEventType {
  ALLOCATE
  DEALLOCATE
  ADJUST
}

enum AllocationType {
  FULL
  PARTIAL
  EXCESS
  ROUNDING
}

enum MatchMethod {
  AUTO_EXACT
  AUTO_PATTERN
  MANUAL
  ADJUSTED
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  DELETED
}

enum DecisionType {
  ACCEPT
  REJECT
  MODIFY
  ESCALATE
}
