{
  "name": "lpg-stock-recon-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:init": "prisma migrate dev --name init",
    "import:dexie": "node scripts/importDexieExport.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "debtors:sync": "node analysis/debtors/shared/scripts/debtors_sync.mjs",
    "debtors:ingest-check": "node analysis/debtors/shared/scripts/validate_txt_db_coverage.mjs",
    "debtors:parse-backlog": "node analysis/debtors/shared/scripts/parse_global_aged_debt.mjs",
    "debtors:knowledge-compile": "node analysis/debtors/shared/scripts/allocation_knowledge_compile.mjs",
    "debtors:customer-statement": "node analysis/debtors/shared/scripts/generate_statement_of_account.mjs",
    "debtors:tag-check": "node analysis/debtors/shared/scripts/check_invoice_tag_coverage.mjs",
    "debtors:tag-check:all": "node analysis/debtors/shared/scripts/check_invoice_tag_coverage.mjs --all",
    "debtors:twk002-allocation-ingest": "node analysis/debtors/TWK002/scripts/remittance_allocation_ingest.mjs --write",
    "debtors:twk002-phantom-cn-report": "node analysis/debtors/TWK002/scripts/build_phantom_cn_report.mjs --write",
    "debtors:twk002-bf-bridge": "node analysis/debtors/TWK002/scripts/build_pre_mar2025_bf_bridge.mjs --write",
    "debtors:test": "node --test analysis/debtors/shared/scripts/*.test.mjs",
    "creditors:export-txt": "node analysis/creditors/shared/scripts/export_creditor_txt_from_db.mjs",
    "creditors:ingest-check": "node analysis/creditors/shared/scripts/validate_txt_db_coverage.mjs",
    "creditors:statement-v5": "node analysis/creditors/shared/scripts/reconcile_creditor_v5_from_txt.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@prisma/client": "^6.19.2",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.98.0",
    "@turf/turf": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^2.30.0",
    "dexie": "^3.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react-day-picker": "^9.13.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "use-places-autocomplete": "^4.0.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.32",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^4.1.4",
    "workbox-window": "^7.0.0"
  }
}
