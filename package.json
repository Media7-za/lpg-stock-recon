    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.32",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
