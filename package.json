    "dexie": "^3.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "uuid": "^13.0.0"
