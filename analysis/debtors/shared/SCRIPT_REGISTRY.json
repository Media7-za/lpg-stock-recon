{
  "$schema": "debtors/script-registry/v1",
  "version": "1.0.0",
  "ratified": "2026-09-29",
  "status": "RATIFIED",
  "ruling": "DEBTORS_DOCTRINE.md D20 — registers declare, discovery only contradicts. Decision D5.",
  "authority": "analysis/debtors/shared/DEBTORS_DOCTRINE.md",
  "plan": "analysis/debtors/shared/docs/REGISTERS_PLAN.md",
  "description": "Canonical catalogue of governed scripts under analysis/**/scripts/. Declares scope, durability, entry points and slice ownership. Durability is never inferred from a filename: a record claims permanence only against named evidence, and stays unclassified otherwise.",
  "governed_roots": [
    "analysis/{lane}/scripts/",
    "analysis/{lane}/shared/scripts/",
    "analysis/{lane}/{ACCOUNT}/scripts/"
  ],
  "scopes": {
    "universal": "Portfolio-wide. Lives under a shared/ segment, or a lane root with no account segment.",
    "account:{CODE}": "Bound to the named account. Provable from the path."
  },
  "kinds": {
    "entrypoint": "Runnable directly. Has, or should have, an npm target.",
    "module": "Imported by something that runs. Not runnable alone.",
    "test": "node --test suite.",
    "query": "SQL executed against the ERP mirror.",
    "wrapper": "Delegates to another script, usually pinning arguments.",
    "backup": "Retained copy of a superseded script.",
    "analysis": "Standalone forensic or one-shot script. Default for anything not yet read."
  },
  "durabilities": {
    "permanent": "Load-bearing. Deleting it breaks a registered entry point, a test, or a caller.",
    "one-shot": "Ran once for a specific investigation and is not expected to run again.",
    "deprecated": "Superseded but retained; a replacement is named.",
    "superseded": "Replaced. Kept only for provenance.",
    "unclassified": "Durability unproven. NOT a claim that the script is dead — it means nobody has read it and recorded a verdict."
  },
  "evidence_kinds": {
    "npm-entrypoint": "A package.json script names this file.",
    "test-suite": "Matches the *.test.mjs convention run by debtors:test.",
    "imported-by-permanent": "Static import from a script reachable from an entry point.",
    "invoked-by-permanent": "Subprocess call from a script reachable from an entry point.",
    "docblock-deprecated": "The file carries an @deprecated tag naming its replacement.",
    "backup-directory": "Lives under scripts/backups/.",
    "operator-declared": "Classified by the operator against reasoning recorded in notes.",
    "none": "No evidence either way. Pairs only with unclassified."
  },
  "missing_entrypoints": [
    {
      "target": "debtors:parse-backlog",
      "declared_path": "analysis/debtors/shared/scripts/parse_global_aged_debt.mjs",
      "status": "ABSENT — no such file, and git log shows it has never existed on any branch. The npm target, two skills, the PRD, the roadmap and CHANGELOG all describe it as delivered.",
      "tag": "PROVEN",
      "evidence": [
        "git log --all -- analysis/debtors/shared/scripts/parse_global_aged_debt.mjs (empty)",
        "CHANGELOG.md:62 announces the script as added",
        "analysis/debtors/shared/docs/DEBTORS_ORCHESTRATION_PRD.md:147 marks it done",
        "analysis/debtors/shared/docs/DEBTORS_ORCHESTRATION_ROADMAP.md:29 marks it done",
        ".agents/skills/SKILL_Debtors_Orchestrator.md:53 instructs running it",
        ".agents/skills/SKILL_Human_Sources_Agent.md:38 instructs running it",
        "analysis/debtors/shared/scripts/debtors_dashboard.mjs:296 prompts the operator to run it"
      ],
      "consequence": "analysis/debtors/shared/data/portfolio_candidates.csv (68 rows) cannot be refreshed. It was last committed 2026-08-29 and nothing records the ERP date behind it, so portfolio triage runs on a frozen input that reads as current.",
      "resolution_required": "operator",
      "resolution_options": [
        "Write the parser against the global aged-debt TXT and keep the target.",
        "Retire the target and the four documents that claim it, and record how portfolio_candidates.csv is produced instead."
      ],
      "reopens_when": "parse_global_aged_debt.mjs is written, or debtors:parse-backlog is removed from package.json. Either event must also update the PRD, roadmap, both skills, and the dashboard prompt."
    }
  ],
